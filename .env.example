# Copy to .env and fill in. Never commit the real .env.
# Make each key with: python -c "import secrets; print(secrets.token_hex(32))"

# Required. Root of all encryption keys. If lost or changed, all stored data is unreadable.
MASTER_KEY=
# Required. HMAC key for email and NIK lookup. Must be different from MASTER_KEY.
LOOKUP_KEY=

# Optional: one setup for everything: aes, des, rc4, or layered (AES, then DES, then RC4 on every item).
# Leave empty for one cipher per data type (profile and video AES, office document RC4, KTP DES).
# CIPHER=layered
# Optional: change single data types, e.g. ktp=aes,supporting_doc=aes
# CIPHER_POLICY=

# Where data is saved. Relative paths start at the repo root.
# On a server this must be storage that is kept between restarts.
DB_PATH=BE/mbanking.db
STORAGE_DIR=BE/storage

# Optional: 1 turns on Flask debug mode. Never on a public server.
# FLASK_DEBUG=1
# Set to production on the server.
# APP_ENV=production
