# Copy to .env and fill in. Never commit the real .env.
# Make each key with: python -c "import secrets; print(secrets.token_hex(32))"

# Root of all encryption keys. If lost, all stored data is unreadable.
MASTER_KEY=
# HMAC key for email and NIK lookup. Must be different from MASTER_KEY.
LOOKUP_KEY=

# Optional: use one cipher for everything (aes, des, rc4). Use aes in production.
# CIPHER=aes
# Optional: change single data types, e.g. ktp=aes,supporting_doc=aes
# CIPHER_POLICY=

# Where data is saved. Must be on storage that is kept between restarts.
DB_PATH=BE/mbanking.db
STORAGE_DIR=BE/storage
